# Copy this file to .env.local and fill in any keys you have.
# EVERY key is optional — JobPilot works without any of them (AI features fall
# back to keyword-based logic, and job sources without a key simply show a
# "key missing" badge). Keys can also be entered on the Settings page instead,
# where they are stored in the local SQLite database.

# --- AI provider (pick ONE; Anthropic wins if both are set) ---
# 1) Anthropic — better results, but prepaid: a key alone does nothing until you
#    add credits. https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=
# 2) Google Gemini — has a genuinely free tier, no card required.
#    https://aistudio.google.com/apikey
#    PRIVACY: Google's terms say free-tier content is used to improve their
#    products and that human reviewers may read it, and advise against sending
#    personal information. A resume is personal information. See
#    https://ai.google.dev/gemini-api/terms
GEMINI_API_KEY=
# Optional model override. Ignored unless it names a model of the active
# provider, so a leftover value cannot be sent to the wrong API.
# Defaults: claude-opus-5 (Anthropic), gemini-3.5-flash (Gemini)
AI_MODEL=

# --- Job search APIs ---
# Jobicy and Remotive (remote jobs) need NO key and are always on — nothing to
# configure. The keys below add the keyed sources on top.

# JSearch is sold two ways. Set EITHER of the next two keys, not both.
# 1) via the RapidAPI marketplace: rapidapi.com -> search "JSearch"
#    (OpenWeb Ninja) -> Subscribe (free Basic plan) -> copy X-RapidAPI-Key
RAPIDAPI_KEY=
# 2) direct from the publisher: app.openwebninja.com/api/jsearch -> subscribe
#    -> copy the API key. Uses a different host and endpoint; JobPilot switches
#    automatically based on which key is present.
OPENWEBNINJA_API_KEY=

# Adzuna: developer.adzuna.com -> Register -> Dashboard shows both values
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: jooble.org/api/about -> request a key (emailed, free)
# NOTE: Jooble currently answers automated requests with a Cloudflare challenge,
# so this may fail even with a valid key. JobPilot reports that clearly and the
# Jooble search link on the Job Search page works regardless.
JOOBLE_API_KEY=

# Careerjet: careerjet.com/partners/api -> Publisher account -> v4 API key.
# This is the Search API v4 key, NOT the old affiliate ID — the legacy
# affid endpoint is closed to new accounts.
CAREERJET_API_KEY=

# --- Misc ---
NEXT_TELEMETRY_DISABLED=1
