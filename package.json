{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "verify": "npm run verify:pipeline && npm run verify:ingest && npm run verify:search && npm run verify:flow",
    "verify:pipeline": "node --import ./scripts/test-env.mjs --import ./scripts/alias-hook.mjs scripts/verify-pipeline.mts scripts/fixtures",
    "verify:ingest": "node --import ./scripts/test-env.mjs --import ./scripts/alias-hook.mjs scripts/verify-url-ingest.mts",
    "verify:search": "node --import ./scripts/test-env.mjs --import ./scripts/alias-hook.mjs scripts/verify-search.mts",
    "verify:flow": "node --import ./scripts/test-env.mjs --import ./scripts/alias-hook.mjs scripts/verify-flow.mts scripts/fixtures",
    "verify:live": "node --import ./scripts/alias-hook.mjs scripts/probe-live.mts",
    "verify:ai": "node --import ./scripts/alias-hook.mjs scripts/probe-ai.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.15.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "12.4.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
